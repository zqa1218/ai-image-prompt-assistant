{
  "name": "prompt-wizard",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "desktop": "electron .",
    "desktop:build": "npm run build && electron-builder --win",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "smoke:upstream": "node scripts/smoke.mjs --upstream",
    "check:dev": "node scripts/check-dev.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^42.4.1",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "build": {
    "appId": "com.promptwizard.desktop",
    "productName": "AI修图提示词助手",
    "artifactName": "AI修图提示词助手-${version}-${arch}.${ext}",
    "directories": {
      "output": "release-desktop"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "assets/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "electron/window-link.ps1",
      "server/photoshop-com-capture.ps1",
      "server/photoshop-com-capture.jsx",
      "electron/click-orb.ps1",
      "electron/*.ps1"
    ],
    "extraResources": [
      {
        "from": "photoshop-plugin",
        "to": "photoshop-plugin"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI修图提示词助手",
      "uninstallDisplayName": "AI修图提示词助手",
      "artifactName": "AI修图提示词助手-Setup-${version}.${ext}",
      "include": "scripts/installer.nsh",
      "deleteAppDataOnUninstall": false
    }
  },
  "description": "AI 修图提示词助手：把底图、参考图和需求编译成可直接使用的修图提示词",
  "author": "zqa1218"
}
