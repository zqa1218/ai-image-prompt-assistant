{
  "manifestVersion": 5,
  "id": "com.promptwizard.photoshop-link",
  "name": "AI修图提示词 Link",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.1.0",
    "data": {
      "apiVersion": 2,
      "loadEvent": "startup"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "promptWizardLink",
      "label": {
        "default": "AI修图提示词 Link"
      },
      "minimumSize": {
        "width": 180,
        "height": 90
      },
      "preferredDockedSize": {
        "width": 240,
        "height": 120
      },
      "preferredFloatingSize": {
        "width": 260,
        "height": 130
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon@1x.png",
          "scale": [
            1
          ],
          "theme": [
            "all"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon@2x.png",
          "scale": [
            2
          ],
          "theme": [
            "all"
          ]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": "all"
    }
  },
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon.png",
      "scale": [
        1
      ],
      "theme": [
        "all"
      ],
      "species": [
        "generic"
      ]
    }
  ]
}
